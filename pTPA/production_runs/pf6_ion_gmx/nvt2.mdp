title                   = NVT Room Temp
; Run parameters
integrator              = md        
nsteps                  = 300000000  
dt                      = 0.001     
; Output control
nstxout                 = 10000   
nstvout                 = 10000   
nstenergy               = 1000    
nstlog                  = 1000    
xtc_precision		= 100
xtc_grps		= System
energygrps		= System


; Neighborsearching
ns_type                 = grid      
nstlist                 = 10       
rlist                   = 0.9      
pbc 	                = xyz
periodic_molecules       = yes

; Electrostatics
coulombtype             = PME       
rcoulomb		= 1.0
fourierspacing          = 0.12
vdw-type		= Cut-off
rvdw			= 1.0

tcoupl                  = nose-hoover            
tc-grps                 = system   
tau_t                   = 0.2 
ref_t                   = 300                   
pcoupl                  = no        

